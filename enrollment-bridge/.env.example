# Spersia Enrollment Bridge — configuration (copy to .env or set as service env)

# HTTP port on 127.0.0.1 (loopback only by design)
BRIDGE_PORT=8485

# Optional shared secret. If set, the web app must send x-bridge-token.
# Also expose the same value to the frontend build as VITE_BRIDGE_TOKEN.
# BRIDGE_TOKEN=change-me

# Where the main project API lives (canonical enrollment store)
SPERSIA_SERVER_URL=http://localhost:3001/api

# Extra directory searched for vendor DLLs and *.sdk.json manifests
# SDK_DIR=C:\Program Files\ZKSoftware\ZKBrowser

# Comma-separated https origins allowed to call the bridge (besides localhost dev ports)
# BRIDGE_ALLOWED_ORIGINS=https://hr.yourcompany.com

# Windows service name used by install-service.mjs / uninstall-service.mjs
# BRIDGE_SERVICE_NAME=SpersiaEnrollmentBridge
