{
  "name": "attendance-system",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.mjs",
    "server:dev": "node --watch server/index.mjs",
    "seed": "node server/seed.mjs",
    "seed:admin": "node server/seed-admin.mjs",
    "start": "concurrently --kill-others --names \"SERVER,CLIENT\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"npm run server\" \"npm run dev\"",
    "start:all": "npm run start",
    "stop": "node scripts/stop.mjs",
    "stop:windows": "stop.bat",
    "stop:unix": "bash stop.sh",
    "test": "node --test tests/",
    "test:server": "node --test tests/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "fdir": "^6.5.0",
    "framer-motion": "^11.16.1",
    "jalaali-js": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.294.0",
    "mssql": "^12.7.2",
    "react": "^18.2.0",
    "react-checkbox-tree": "^2.1.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.4.4"
  }
}
