# SQL Server Configuration
DB_SERVER=localhost
DB_DATABASE=AttendanceDB
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_PORT=1433

# Server Configuration
SERVER_PORT=3001
CLIENT_PORT=3000
NODE_ENV=development

# CORS Configuration
# FRONTEND_URL=http://localhost:3000

# JWT Configuration
# REQUIRED in production (>=32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access-token lifetime (default: 15m). Refresh tokens rotate every 7 days.
JWT_EXPIRES_IN=15m
# Comma-separated list of allowed CORS origins (defaults to http://localhost:${CLIENT_PORT})
# FRONTEND_URL=http://localhost:3000,https://attendance.example.com
